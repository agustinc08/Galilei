// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int      @id @default(autoincrement())
  email    String   @unique
  password String
  role     String
  username String?  // Nuevo campo username
}

model Doc {
  id           Int       @id @default(autoincrement())
  numero       Int
  path         String
  tipo         Int
  voz          String
  pdfContent   String
  fecha        DateTime  @default(now()) // Agregamos el campo fecha
  pendiente    Boolean?  // Nuevo campo pendiente de tipo booleano
  idDocAsociado Int?
}
model DocDependencias{
 idDocAsociado Int
 idDependenciaAsociada Int
  @@id([idDocAsociado, idDependenciaAsociada])

}

model Dependencia {

  id Int @id @default(autoincrement())
  descripcion String

}



model Tipo{
  id Int @id @default(autoincrement())
  nombre String
}
