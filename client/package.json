{
  "name": "front",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4001 --strictPort",
    "dev:qa": "vite --host 127.0.0.1 --strictPort",
    "build": "pnpm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4002 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/preprod-build-env.test.mjs ux-qa/self-test.cjs && node --experimental-strip-types --test tests/pdf-text-search.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:research": "playwright test --config playwright.research.config.ts",
    "lint": "eslint src vite.config.ts playwright.config.ts playwright.preprod.config.ts playwright.research.config.ts scripts ux-qa tests preprod-tests",
    "lint:ux": "eslint ux-qa tests/ux-*.spec.cjs",
    "qa:ux": "node --test ux-qa/self-test.cjs && node ux-qa/run.cjs public",
    "qa:ux:self": "node --test ux-qa/self-test.cjs",
    "qa:ux:public": "node ux-qa/run.cjs public",
    "qa:ux:responsive": "node ux-qa/run.cjs responsive",
    "qa:ux:viewer": "node ux-qa/run.cjs viewer",
    "qa:ux:auth": "node ux-qa/auth-preflight.cjs && node ux-qa/run.cjs auth",
    "preprod:env:check": "node scripts/preprod-build-env.mjs",
    "preprod:env:test": "node --test scripts/preprod-build-env.test.mjs"
  },
  "dependencies": {
    "pdfjs-dist": "6.3.289",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-pdf": "^11.0.0",
    "react-router-dom": "7.18.4",
    "vite": "8.3.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
