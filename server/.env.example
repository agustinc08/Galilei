PORT=4000
BJC_API_BIND_HOST=127.0.0.1
FRONTEND_URL=http://localhost:4002
FRONTEND_URLS=http://localhost:4002

DATABASE_URL=postgresql://bjc_dev:replace-with-local-dev-password@127.0.0.1:55432/buscador_juridico_civil_dev
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_AUTH_MAX=15
API_RATE_LIMIT_SEARCH_MAX=120
API_RATE_LIMIT_MATCHES_MAX=120
API_RATE_LIMIT_DOWNLOAD_MAX=120
BJC_SEARCH_STATEMENT_TIMEOUT_MS=4000
BJC_SLOW_SEARCH_MS=1500
SQLITE_SOURCE_PATH=
SQLITE_PDF_BASE_PATH=
IMPORT_BATCH_SIZE=500

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_GENERATION_MODEL=llama3
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
IA_MAX_CHARS=30000

# PREPROD: provisionar desde vault institucional; no copiar estos valores a runtime.
# La identidad de DATABASE_URL debe coincidir exactamente con las cuatro variables BJC_PREPROD_DB_*.
# NODE_ENV=production
# BJC_DEPLOYMENT_ENV=preprod
# BJC_PREPROD_DATABASE_APPROVED=false
# BJC_PREPROD_DB_HOST=<fqdn-postgresql-preprod>
# BJC_PREPROD_DB_PORT=5432
# BJC_PREPROD_DB_NAME=buscador_juridico_civil_preprod
# BJC_PREPROD_DB_USER=<rol-preprod-minimo>
# PGPASSFILE=<archivo-de-credenciales-acl-restringido-desde-vault>
# DATABASE_URL=<postgresql-url-desde-vault>
# JWT_SECRET=<secreto-desde-vault>
# JWT_EXPIRES_IN=2h
# FRONTEND_URL=https://<frontend-preprod-interno>
# FRONTEND_URLS=https://<frontend-preprod-interno>
# BJC_PREPROD_FRONTEND_ORIGIN=https://<frontend-preprod-interno>
# BJC_PREPROD_API_ORIGIN=https://<api-preprod-interno>
# BJC_CORPUS_STORAGE_PATH=<ruta-absoluta-storage-preprod-persistente>
# API_RATE_LIMIT_ENABLED=true
# API_RATE_LIMIT_WINDOW_MS=60000
# API_RATE_LIMIT_AUTH_MAX=15
# API_RATE_LIMIT_SEARCH_MAX=120
# API_RATE_LIMIT_MATCHES_MAX=120
# API_RATE_LIMIT_DOWNLOAD_MAX=120
# BJC_PREPROD_REPLICAS=1
# BJC_SEARCH_STATEMENT_TIMEOUT_MS=4000
# BJC_RELEASE_ID=BJC-PREPROD-RC1
# BJC_BACKEND_BUILD_ID=<backend-build>
# BJC_FRONTEND_BUILD_ID=<frontend-build>
# BJC_PREPROD_SMOKE_EMAIL=<cuenta-uat-aprobada-desde-vault>
# BJC_PREPROD_SMOKE_PASSWORD=<secreto-desde-vault>
# BJC_PREPROD_SMOKE_DOCUMENT_ID=<id-documento-aprobado>
# BJC_PREPROD_REPORT_PATH=<ruta-absoluta-nueva-para-acceptance-json>
