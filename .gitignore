# Dependencias de paquetes independientes
**/node_modules/
**/.pnpm-store/

# Secretos y entornos locales
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
!**/.env.template
!**/.env.sample

# Salidas generadas concretas; no ignorar directorios fuente genéricos
/client/.next/
/client/out/
/client/coverage/
/client/.turbo/
/client/test-results/
/client/playwright-report/
/server/dist/
/server/build/
/server/coverage/
/server/.cache/
/server/generated/
**/*.tsbuildinfo

# Datos locales y runtimes del checkout
/server/logs/
/server/uploads/
/server/tmp/
/server/data/pdfs/
/server/data/*.sqlite
/server/data/*.sqlite3
/server/data/*.db
/_dev-corpus-storage/
/_dev-corpus-storage-test/
/_recovery-work/
/_recovery-backups/
/_legacy-audit-work/
/_local-setup/

# Backups locales en ruta de datos runtime
/server/data/*.sqlite-*
/server/data/*.db-*
/server/data/*.dump
/server/data/*.backup
/server/data/*.sql.gz

# Logs y diagnósticos de herramientas
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/*.pid

# Editores y sistema operativo
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.pem
