# PLANTILLA únicamente. No cargar sin reemplazo por valores aprobados desde el vault.
# Nunca copiar secretos de DEV. Los placeholders y BJC_PREPROD_DATABASE_APPROVED=false
# hacen que el backend y el deploy aborten hasta completar el provisionamiento.
NODE_ENV=production
BJC_DEPLOYMENT_ENV=preprod
PORT=4001
BJC_API_BIND_HOST=127.0.0.1

BJC_PREPROD_DATABASE_APPROVED=false
BJC_PREPROD_DB_HOST=<fqdn-postgresql-preprod>
BJC_PREPROD_DB_PORT=5432
BJC_PREPROD_DB_NAME=buscador_juridico_civil_preprod
BJC_PREPROD_DB_USER=<rol-preprod-minimo>
BJC_PREPROD_DB_CA_PATH=<ruta-absoluta-a-ca-postgresql-preprod.pem>
# sslrootcert is the node-postgres source path; sslcert/sslaccept configure Prisma CLI.
# All three CA references must resolve to the same file; never embed a secret in a committed URL.
DATABASE_URL=postgresql://<rol-preprod>:<secreto>@<fqdn-postgresql-preprod>:5432/buscador_juridico_civil_preprod?sslmode=verify-full&sslrootcert=<ruta-url-encoded-a-ca-postgresql-preprod.pem>&sslcert=<misma-ruta-url-encoded-a-ca>&sslaccept=strict
PGPASSFILE=<archivo-acl-restringido-desde-vault-para-herramientas-pg>

JWT_SECRET=<secreto-aleatorio-desde-vault-minimo-32-caracteres>
JWT_EXPIRES_IN=2h
FRONTEND_URL=https://<frontend-preprod-fqdn>
FRONTEND_URLS=https://<frontend-preprod-fqdn>
BJC_PREPROD_API_ORIGIN=https://<api-preprod-fqdn>
BJC_PREPROD_FRONTEND_ORIGIN=https://<frontend-preprod-fqdn>
BJC_CORPUS_STORAGE_PATH=<ruta-absoluta-del-volumen-preprod-persistente>
BJC_DEV_CORPUS_STORAGE_PATH=<ruta-canonica-del-storage-dev-para-rechazar-solapamiento>

# OpenSearch debe ser TLS + autenticado; prefijo/alias no pueden ser los de DEV.
OPENSEARCH_NODE=https://<opensearch-preprod-fqdn>:9200
OPENSEARCH_USERNAME=<rol-opensearch-preprod-desde-vault>
OPENSEARCH_PASSWORD=<secreto-desde-vault>
OPENSEARCH_CA_PATH=<ruta-a-ca-institucional-si-no-esta-en-trust-store>
OPENSEARCH_INDEX_ALIAS=galilei-preprod-search-active
OPENSEARCH_INDEX_PREFIX=galilei-preprod-search
OPENSEARCH_REQUEST_TIMEOUT_MS=5000
OPENSEARCH_MAX_RETRIES=2

API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_AUTH_MAX=15
API_RATE_LIMIT_SEARCH_MAX=120
API_RATE_LIMIT_MATCHES_MAX=120
API_RATE_LIMIT_DOWNLOAD_MAX=120
BJC_PREPROD_REPLICAS=1
BJC_SEARCH_STATEMENT_TIMEOUT_MS=4000
BJC_SLOW_SEARCH_MS=1500
BJC_OCR_QUEUE_NAME=preprod
SEARCH_ENGINE=opensearch
OCR_ENABLED=false

BJC_PREPROD_SMOKE_EMAIL=<cuenta-de-smoke-aprobada>
BJC_PREPROD_SMOKE_PASSWORD=<secreto-desde-vault>
BJC_PREPROD_SMOKE_DOCUMENT_ID=<id-de-documento-aprobado>
BJC_RELEASE_ID=<release-aprobado>
BJC_BACKEND_BUILD_ID=<id-build-backend>
BJC_FRONTEND_BUILD_ID=<id-build-frontend>
GIT_COMMIT_SHA=<sha-aprobado-de-40-hex>
BJC_PREPROD_REPORT_PATH=<ruta-absoluta-nueva-para-el-reporte>

# Optionales: sólo habilitar por decisión del owner y con capacidad instalada.
OCR_ENGINE_PATH=<ruta-a-motor-ocr-aprobado>
OCR_RENDERER_PATH=<ruta-a-renderizador-pdf-aprobado>
OCR_LANGUAGES=spa
OCR_MAX_PENDING_JOBS=10
OCR_TEMP_DIR=<ruta-temporal-preprod-con-cuota>
OCR_TESSDATA_DIR=<ruta-a-datos-tesseract-aprobados>
DOC_EXTRACTOR_PATH=<ruta-a-extractor-doc-aprobado>
OLLAMA_BASE_URL=<endpoint-ollama-privado-si-se-aprueba>
OLLAMA_GENERATION_MODEL=<modelo-aprobado>
OLLAMA_EMBEDDING_MODEL=<modelo-aprobado>
OLLAMA_EMBEDDINGS_MODEL=<modelo-aprobado-legacy-opcional>
OLLAMA_MODEL=<modelo-legacy-opcional>
OLLAMA_URL=<endpoint-legacy-opcional>
IA_MAX_CHARS=30000
