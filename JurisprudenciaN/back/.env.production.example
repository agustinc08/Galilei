# PLANTILLA únicamente. Producción requiere valores aprobados inyectados por el vault.
# No copiar valores ni secretos desde DEV o PREPROD. Sin approval, CA y namespace exactos, el backend aborta.
NODE_ENV=production
BJC_DEPLOYMENT_ENV=production
PORT=4001
BJC_API_BIND_HOST=127.0.0.1

BJC_PRODUCTION_DATABASE_APPROVED=false
BJC_PRODUCTION_DB_HOST=<fqdn-postgresql-production>
BJC_PRODUCTION_DB_PORT=5432
BJC_PRODUCTION_DB_NAME=<database-production-aprobada-distinta-de-dev-y-preprod>
BJC_PRODUCTION_DB_USER=<rol-production-minimo>
BJC_PRODUCTION_DB_CA_PATH=<ruta-absoluta-a-ca-postgresql-production.pem>
# sslrootcert is the node-postgres source path; sslcert/sslaccept configure Prisma CLI.
# All three CA references must resolve to the same file; never embed a secret in a committed URL.
DATABASE_URL=postgresql://<rol-production>:<secreto>@<fqdn-postgresql-production>:5432/<database-production>?sslmode=verify-full&sslrootcert=<ruta-url-encoded-a-ca-postgresql-production.pem>&sslcert=<misma-ruta-url-encoded-a-ca>&sslaccept=strict

JWT_SECRET=<secreto-aleatorio-del-vault-minimo-32-caracteres>
JWT_EXPIRES_IN=2h
FRONTEND_URL=https://<frontend-production-fqdn>
FRONTEND_URLS=https://<frontend-production-fqdn>
BJC_CORPUS_STORAGE_PATH=<ruta-absoluta-del-volumen-production>
BJC_DEV_CORPUS_STORAGE_PATH=<ruta-del-storage-dev-para-rechazar-solapamiento>
BJC_PREPROD_CORPUS_STORAGE_PATH=<ruta-del-storage-preprod-para-rechazar-solapamiento>

SEARCH_ENGINE=opensearch
OPENSEARCH_NODE=https://<opensearch-production-fqdn>:9200
OPENSEARCH_USERNAME=<rol-opensearch-production-desde-vault>
OPENSEARCH_PASSWORD=<secreto-desde-vault>
OPENSEARCH_INDEX_ALIAS=galilei-production-search-active
OPENSEARCH_INDEX_PREFIX=galilei-production-search

API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_AUTH_MAX=15
API_RATE_LIMIT_SEARCH_MAX=120
API_RATE_LIMIT_MATCHES_MAX=120
API_RATE_LIMIT_DOWNLOAD_MAX=120
BJC_PRODUCTION_REPLICAS=1
BJC_SEARCH_STATEMENT_TIMEOUT_MS=4000
BJC_SLOW_SEARCH_MS=1500
